# ====================================================
#     字幕擦除助手 配置文件 (请使用记事本修改)
# ====================================================

# [必填] 火山引擎 API 密钥 (可在火山引擎控制台 -> 密钥管理获取)
VOLCENGINE_API_KEY=

# [必填] Cpolar 激活凭证 (登录 https://dashboard.cpolar.com/ 获取)
CPOLAR_AUTHTOKEN=

# [必填] Cpolar 穿透后分配的公网 URL 地址 
# (启动 Cpolar 隧道后，可在 https://dashboard.cpolar.com/tunnels 中看到形如 https://xxxx.cpolar.cn 的地址)
# 例如: PUBLIC_URL=https://e3a2b1c0.cpolar.io
PUBLIC_URL=
