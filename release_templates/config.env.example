# ====================================================
#     字幕擦除助手 配置文件 (请使用记事本修改)
# ====================================================

# [必填] 火山引擎 API 密钥 (可在火山引擎控制台 -> 密钥管理获取)
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# [必填] Cpolar 激活凭证 (登录 https://dashboard.cpolar.com/ 获取)
CPOLAR_AUTHTOKEN=your_cpolar_authtoken_here

# [选填] Cpolar 穿透后分配的公网 URL 地址 
# (系统已支持自动检测 Cpolar 公网域名，通常无需手动配置，保留空值或注释即可)
# 例如: PUBLIC_URL=https://e3a2b1c0.cpolar.io
PUBLIC_URL=
